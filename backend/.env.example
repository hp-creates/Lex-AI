# === LexAI Environment Variables ===
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# === App ===
ENVIRONMENT=development
FRONTEND_ORIGIN=http://localhost:5173

# === Qdrant ===
# Cloud mode: set QDRANT_URL + QDRANT_API_KEY (overrides host/port)
# Local mode: leave QDRANT_URL empty to use QDRANT_HOST:QDRANT_PORT
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_HOST=localhost
QDRANT_PORT=6333

# === Groq (LLM) ===
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.6-27b

# === Embedding Model (legal-bge-m3) ===
EMBEDDING_MODE=local
EMBEDDING_MODEL=yuriyvnv/legal-bge-m3
HF_API_TOKEN=

# === Supabase (Auth + DB) ===
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# === BM25 ===
BM25_INDEX_PATH=data/bm25_index.pkl

# === LangSmith Tracing (optional) ===
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=lex-ai
